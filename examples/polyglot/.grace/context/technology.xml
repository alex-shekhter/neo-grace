<GraceTechnology graceVersion="4.0">
  <Summary>Multi-stack monorepo: web UI, Go API, Rust core.</Summary>
  <Stacks>
    <Stack-WEB>
      <Root>apps/web</Root>
      <Language>TypeScript</Language>
      <Runtime>Bun</Runtime>
      <Framework>React</Framework>
      <TestingStack>bun:test</TestingStack>
    </Stack-WEB>
    <Stack-API>
      <Root>services/api</Root>
      <Language>Go</Language>
      <Runtime>go1.22+</Runtime>
      <TestingStack>go test</TestingStack>
    </Stack-API>
    <Stack-CORE>
      <Root>crates/core</Root>
      <Language>Rust</Language>
      <Runtime>cargo</Runtime>
      <TestingStack>cargo test</TestingStack>
    </Stack-CORE>
  </Stacks>
</GraceTechnology>
