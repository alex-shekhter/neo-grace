    <ImplementationPlan>
      <T-001>
        <Title>Grammar third state, both-states, and change catalogs</Title>
        <DependsOn></DependsOn>
        <AcceptanceCriteria>
          <Criterion>
            A complete CloseEvidence AC-*
            (one non-empty Command child)
            does not emit
            change.acceptance-criterion-unmapped.
            collectAcceptanceCriteriaIds
            still lists it.
          </Criterion>
          <Criterion>
            Empty CloseEvidence, CloseEvidence
            with no Command, or CloseEvidence
            whose children are not Command,
            emits change.close-evidence-incomplete
            at error and does not exempt
            unmapped.
          </Criterion>
          <Criterion>
            Satisfies of a complete
            CloseEvidence AC-* emits
            change.close-evidence-and-satisfied
            at error. Satisfies of an
            unknown AC-* stays
            change.unknown-acceptance-criterion.
          </Criterion>
          <Criterion>
            Both new change.* codes have
            exact EXACT_GUIDES entries and
            are not on
            PREFIX_COVERED_LEGACY_CODES.
            Forgotten AC-* still warn
            unmapped at warning, same code,
            same message family. Legacy
            free-text AcceptanceCriteria
            still skip mapping.
          </Criterion>
        </AcceptanceCriteria>
        <Verification>
          <Command>bun test src/artifact/grammar.test.ts src/lint/catalog.test.ts</Command>
        </Verification>
        <Satisfies>
          <AC-THIRD-STATE-DISTINCT />
          <AC-FORGOTTEN-UNCHANGED />
          <AC-NOT-BOTH />
        </Satisfies>
      </T-001>
      <T-002>
        <Title>plan new Satisfies only ordinary AC-*</Title>
        <DependsOn>T-001</DependsOn>
        <AcceptanceCriteria>
          <Criterion>
            renderChangePlan / plan new
            writes Satisfies only for spec
            AC-* that are not close-bound.
            A spec with one complete
            CloseEvidence AC-* and one
            ordinary AC-* yields a skeleton
            that Satisfies-links only the
            ordinary one.
          </Criterion>
        </AcceptanceCriteria>
        <Verification>
          <Command>bun test src/artifact/skeletons.test.ts src/grace-generate.test.ts</Command>
        </Verification>
        <Satisfies>
          <AC-SKELETON-EXCLUDES />
        </Satisfies>
      </T-002>
      <T-003>
        <Title>gate verdict evaluates CloseEvidence on applied archives</Title>
        <DependsOn>T-001</DependsOn>
        <AcceptanceCriteria>
          <Criterion>
            When gate verdict runs against
            a bundle whose path is under
            archive/ and whose spec status
            is applied, it runs each
            complete CloseEvidence Command
            and records one AC-* child per
            such criterion on that Verdict,
            with Exit and Result children
            as pinned in the DESIGN comment.
          </Criterion>
          <Criterion>
            It refuses to record outcome
            pass if any named Command exits
            non-zero. No Verdict is written
            in that refuse.
          </Criterion>
          <Criterion>
            When gate verdict runs against
            an active bundle, it does not
            run CloseEvidence and still
            writes an empty-children Verdict.
            GATE_SUBCOMMANDS and the gate,
            lint, and review arg maps gain
            no new token.
          </Criterion>
        </AcceptanceCriteria>
        <Verification>
          <Command>bun test src/gates/core.test.ts</Command>
        </Verification>
        <Satisfies>
          <AC-EVALUATED-AT-CLOSE />
          <AC-NO-NEW-ARGV />
        </Satisfies>
      </T-003>
      <T-004>
        <Title>review finds missing close-evidence records</Title>
        <DependsOn>T-001</DependsOn>
        <AcceptanceCriteria>
          <Criterion>
            ngrace review with argv token
            change on an applied archived
            bundle emits
            review.close-evidence-unevaluated
            when a complete CloseEvidence
            AC-* has no recorded evaluation
            on any Verdict. The finding is
            not a lint change.* code.
          </Criterion>
          <Criterion>
            The same review on an active,
            superseded, cancelled, or
            rejected bundle does not emit
            that finding. Forgotten AC-*
            on cancelled or rejected still
            warn unmapped. Superseded
            coverage stays skipped. This
            detector does not refuse the
            close.
          </Criterion>
        </AcceptanceCriteria>
        <Verification>
          <Command>bun test src/review/core.test.ts src/artifact/grammar.test.ts src/lint/catalog.test.ts</Command>
        </Verification>
        <Satisfies>
          <AC-REVIEW-DETECTS-ABSENCE />
          <AC-TERMINAL-INERT />
        </Satisfies>
      </T-004>
      <T-005>
        <Title>Teach CloseEvidence, remeasure pins, suite and archive compat</Title>
        <DependsOn>T-002 T-003 T-004</DependsOn>
        <AcceptanceCriteria>
