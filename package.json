{
  "name": "@neograce/cli",
  "version": "6.1.0",
  "description": "neo-grace CLI for .ngrace linting, status snapshots, module health, verification queries, semantic markup, and artifact navigation with a Bun-powered ngrace binary.",
  "license": "MIT",
  "homepage": "https://github.com/alex-shekhter/neo-grace#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alex-shekhter/neo-grace.git"
  },
  "bugs": {
    "url": "https://github.com/alex-shekhter/neo-grace/issues"
  },
  "keywords": [
    "grace",
    "cli",
    "lint",
    "bun",
    "python",
    "typescript",
    "semantic-markup",
    "knowledge-graph"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src/grace-file.ts",
    "src/project-utils.ts",
    "src/grace.ts",
    "src/grace-context.ts",
    "src/grace-cursor.ts",
    "src/grace-doctor.ts",
    "src/grace-graph.ts",
    "src/grace-lint.ts",
    "src/grace-module.ts",
    "src/grace-status.ts",
    "src/grace-verification.ts",
    "src/artifact",
    "src/language-registry.ts",
    "src/lint",
    "src/query",
    "src/verification",
    "src/calibration",
    "src/gates",
    "src/review",
    "!src/**/*.test.ts",
    "!src/artifact/test-fixtures.ts",
    "!src/review/scorer.ts",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "ngrace": "bun run ./src/grace.ts",
    "ngrace:lint": "bun run ./src/grace.ts lint",
    "lint": "bun run ./src/grace.ts lint",
    "test": "bun test --timeout=30000",
    "typecheck": "bunx tsc --noEmit",
    "validate:cli": "bun test --timeout=120000 src/grace-lint.test.ts src/grace-status.test.ts src/grace-query.test.ts",
    "validate:examples": "bun run ./src/grace.ts lint --path examples/polyglot --fail-on errors && bun run ./scripts/validate-walkthrough.ts",
    "validate:determinism": "bun test --timeout=120000 src/review/core.test.ts src/review/scorer.test.ts && bun run ./scripts/validate-determinism.ts",
    "validate:ci": "bun run typecheck && bun run test && bun run validate:cli && bun run ./scripts/validate-marketplace.ts && bun run validate:examples && bun run validate:determinism && bun run validate:packed",
    "validate:marketplace": "bun run ./scripts/validate-marketplace.ts",
    "validate:release": "bun run typecheck && bun run test && bun run validate:cli && bun run release:check && bun run ./scripts/validate-marketplace.ts && bun run validate:examples && bun run validate:packed",
    "validate:packed": "bun run ./scripts/packed-cli-smoke.ts",
    "release:check": "bun run scripts/release-check.ts",
    "release:bump": "bun run scripts/release-bump.ts",
    "release:finalize": "bun run scripts/release-finalize.ts",
    "release:checklist": "bun run ./scripts/release-checklist.ts",
    "prepublishOnly": "bun run validate:release",
    "hooks:install": "lefthook install --force"
  },
  "bin": {
    "ngrace": "src/grace.ts"
  },
  "dependencies": {
    "citty": "^0.2.2",
    "fast-xml-parser": "^5.2.5",
    "typescript": "^6.0.2"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^19.8.1",
    "@types/bun": "^1.3.14",
    "commitlint": "^19.8.1",
    "conventional-changelog-cli": "^5.0.0",
    "lefthook": "^1.11.12"
  },
  "author": {
    "name": "Alex Shekhter",
    "email": "alex.shekhter@gmail.com",
    "url": "https://github.com/alex-shekhter"
  }
}
